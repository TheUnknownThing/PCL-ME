<UserControl
    x:Class="PCL.Frontend.Avalonia.Desktop.Extensions.ExtensionTrustWarningView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:PCL.UI.Controls;assembly=PCL.UI"
    IsVisible="False">
  <Border x:Name="WarningSurface" CornerRadius="7"
          Background="{DynamicResource ColorBrushMsgBox}"
          BoxShadow="{DynamicResource ColorShadowPromptPanel}">
    <Grid RowDefinitions="Auto,2,13,*,Auto" Margin="22,22,22,23">
      <TextBlock x:Name="WarningTitle" Margin="7,-1,70,9" FontSize="23" TextWrapping="Wrap"
                 Foreground="{DynamicResource ColorBrushRedLight}" />
      <Rectangle Grid.Row="1" Height="2" Fill="{DynamicResource ColorBrushRedLight}" />
      <Border Grid.Row="3" Margin="0,0,0,17" Padding="7,0,15,0">
        <ScrollViewer x:Name="WarningMessageScrollViewer" MaxHeight="380"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <TextBlock x:Name="WarningText" Padding="1,1,1,2" FontSize="15" LineHeight="20"
                     Width="{Binding Viewport.Width, ElementName=WarningMessageScrollViewer}"
                     TextWrapping="WrapWithOverflow" Foreground="{DynamicResource ColorBrushMsgBoxText}" />
        </ScrollViewer>
      </Border>
      <ui:PclButton x:Name="AcknowledgeButton" Grid.Row="4" MinWidth="96" Margin="150,0,8,0"
                    HorizontalAlignment="Right" ColorType="Red" ContentPadding="8,5" TextMargin="0,-1,0,0" />
    </Grid>
  </Border>
</UserControl>
