<UserControl
    x:Class="PCL.Frontend.Avalonia.Desktop.Extensions.ExtensionCardView"
    xmlns="https://github.com/avaloniaui"
    xmlns:ui="clr-namespace:PCL.UI.Controls;assembly=PCL.UI"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Styles>
    <Style Selector="ui|PclIconButton">
      <Setter Property="HoverBackgroundBrush" Value="{DynamicResource ColorBrushBg1}" />
      <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
    </Style>
    <Style Selector="ui|PclButton.ToolTipOnDisabled">
      <Setter Property="ToolTip.ShowOnDisabled" Value="True" />
    </Style>
  </UserControl.Styles>
  <ui:PclCard x:Name="Card" ShowChevron="True" IsChevronExpanded="False"
                    ContentMargin="20,52,20,15">
    <ui:PclCard.HeaderOverlayContent>
      <StackPanel x:Name="HeaderActions" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal" Spacing="2" Margin="0,0,36,0">
        <ui:PclIconButton x:Name="ToggleEnabledButton" />
        <ui:PclIconButton x:Name="InfoButton" />
      </StackPanel>
    </ui:PclCard.HeaderOverlayContent>
    <ui:PclCard.CardContent>
      <StackPanel Spacing="12">
        <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" />
        <TextBlock x:Name="ErrorText" IsVisible="False" TextWrapping="Wrap"
                   Foreground="{DynamicResource ColorBrushSemanticErrorForeground}" />
        <TextBlock x:Name="NoticeText" IsVisible="False" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource ColorBrushSemanticWarningForeground}" />
        <ui:PclButton x:Name="RetryButton" HorizontalAlignment="Left" />
        <StackPanel x:Name="SettingsPanel" Spacing="12" />
        <StackPanel x:Name="ShortcutsPanel" Spacing="10" />
        <StackPanel x:Name="NativeSettingsPanel" Spacing="12" />
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
          <ui:PclButton x:Name="ResetButton" />
          <ui:PclButton x:Name="UpdateButton" Classes="ToolTipOnDisabled" />
          <ui:PclButton x:Name="LogButton" />
          <ui:PclButton x:Name="UninstallButton" Classes="ToolTipOnDisabled" />
        </StackPanel>
        <TextBlock x:Name="OperationErrorText" IsVisible="False" TextWrapping="Wrap"
                   Foreground="{DynamicResource ColorBrushSemanticErrorForeground}" />
      </StackPanel>
    </ui:PclCard.CardContent>
  </ui:PclCard>
</UserControl>
