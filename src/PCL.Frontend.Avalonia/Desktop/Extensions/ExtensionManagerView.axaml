<UserControl
    x:Class="PCL.Frontend.Avalonia.Desktop.Extensions.ExtensionManagerView"
    xmlns="https://github.com/avaloniaui"
    xmlns:ui="clr-namespace:PCL.UI.Controls;assembly=PCL.UI"
    xmlns:extensions="clr-namespace:PCL.Frontend.Avalonia.Desktop.Extensions"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Styles>
    <Style Selector="StackPanel.install-actions">
      <Setter Property="Grid.Column" Value="1" />
    </Style>
    <Style Selector=".compact StackPanel.install-actions">
      <Setter Property="Grid.Row" Value="1" />
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Margin" Value="0,12,0,0" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
  </UserControl.Styles>
  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="25,25,25,15" Spacing="15">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
        <StackPanel Spacing="4">
          <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" />
          <TextBlock x:Name="CountText" FontSize="12"
                     Foreground="{DynamicResource ColorBrushEntrySecondaryIdle}" />
        </StackPanel>
        <StackPanel Classes="install-actions" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <ui:PclButton x:Name="ActionsButton" />
          <ui:PclButton x:Name="InstallButton" />
          <ui:PclButton x:Name="InstallUrlButton" ColorType="Highlight" />
        </StackPanel>
      </Grid>
      <ui:PclSearchBox x:Name="ExtensionSearch" />
      <TextBlock x:Name="SafeModeText" TextWrapping="Wrap"
                 Foreground="{DynamicResource ColorBrushSemanticWarningForeground}" />
      <TextBlock x:Name="FeedbackText" IsVisible="False" TextWrapping="Wrap"
                 Foreground="{DynamicResource ColorBrushSemanticErrorForeground}" />
      <extensions:ExtensionRegionHost x:Name="ExtensionSections" Region="settings.extensions.sections"
                                      IsVisible="{Binding Children.Count, RelativeSource={RelativeSource Self}}" />
      <StackPanel x:Name="ExtensionCards" Spacing="15" />
      <TextBlock x:Name="EmptyText" IsVisible="False" Margin="0,20" TextAlignment="Center" TextWrapping="Wrap"
                 Foreground="{DynamicResource ColorBrushEntrySecondaryIdle}" />
      <ui:PclCard x:Name="DiagnosticsCard" ShowChevron="True" IsChevronExpanded="False"
                        ContentMargin="20,52,20,15">
        <ui:PclCard.CardContent>
          <TextBox x:Name="DiagnosticsText" IsReadOnly="True" AcceptsReturn="True"
                   TextWrapping="Wrap" MaxHeight="240" />
        </ui:PclCard.CardContent>
      </ui:PclCard>
    </StackPanel>
  </ScrollViewer>
</UserControl>
