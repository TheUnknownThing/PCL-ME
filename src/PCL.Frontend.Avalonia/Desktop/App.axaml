<Application
    x:Class="PCL.Frontend.Avalonia.Desktop.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:animation="clr-namespace:PCL.UI.Animation;assembly=PCL.UI"
    RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://PCL.UI/Themes/ThemeResources.axaml" />
        <ResourceInclude Source="avares://PCL.UI/Themes/SemanticResources.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <GridLength x:Key="SliderPreContentMargin">6</GridLength>
      <GridLength x:Key="SliderPostContentMargin">6</GridLength>
      <x:Double x:Key="SliderHorizontalHeight">28</x:Double>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <StyleInclude Source="avares://PCL.UI/Themes/PclTheme.axaml" />
    <Style Selector="Popup">
      <Setter Property="ShouldUseOverlayLayer" Value="True" />
    </Style>
  </Application.Styles>
</Application>
