<UserControl
    x:Class="PCL.Frontend.Avalonia.Desktop.Controls.LaunchProfileLoginOverlay"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:PCL.UI.Controls;assembly=PCL.UI"
    xmlns:vm="clr-namespace:PCL.Frontend.Avalonia.ViewModels"
    xmlns:animation="clr-namespace:PCL.UI.Animation;assembly=PCL.UI"
    x:DataType="vm:LauncherViewModel">
  <UserControl.Styles>
    <Style Selector="RadioButton.auth-provider">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalAlignment" Value="Stretch" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="Background" Value="{DynamicResource ColorBrushHalfWhite}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ColorBrushGray5}" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border
              Background="{TemplateBinding Background}"
              BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="1"
              CornerRadius="5"
              Padding="{TemplateBinding Padding}">
            <Grid ColumnDefinitions="16,*" ColumnSpacing="10">
              <Grid Width="16" Height="16" VerticalAlignment="Center">
                <Ellipse x:Name="ProviderRing"
                         Stroke="{DynamicResource ColorBrushEntrySecondaryIdle}" StrokeThickness="1.5" />
                <Ellipse x:Name="ProviderDot" Width="8" Height="8"
                         Fill="{DynamicResource ColorBrush3}" IsVisible="False" />
              </Grid>
              <ContentPresenter Grid.Column="1"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                VerticalContentAlignment="Center" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.auth-provider:pointerover, RadioButton.auth-provider:checked">
      <Setter Property="Background" Value="{DynamicResource ColorBrushEntrySelectedBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush3}" />
    </Style>
    <Style Selector="RadioButton.auth-provider:checked /template/ Ellipse#ProviderRing">
      <Setter Property="Stroke" Value="{DynamicResource ColorBrush3}" />
    </Style>
    <Style Selector="RadioButton.auth-provider:checked /template/ Ellipse#ProviderDot">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="RadioButton.auth-provider TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="StackPanel#AuthlibEditor TextBox">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="9,5" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="TextBlock.auth-label">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.auth-hint">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource ColorBrushEntrySecondaryIdle}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Button.microsoft-device-code">
      <Setter Property="Padding" Value="4" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <ControlTemplate>
          <ContentPresenter Background="Transparent"
                            Padding="{TemplateBinding Padding}"
                            Content="{TemplateBinding Content}" />
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="Button.login-method">
      <Setter Property="Padding" Value="10" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
      <Setter Property="RenderTransform" Value="scale(1)" />
      <Setter Property="Transitions">
        <Transitions>
          <TransformOperationsTransition Property="RenderTransform" Duration="{Binding InteractiveState, Source={x:Static animation:MotionDurations.Source}}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.login-method:pressed">
      <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>
    <Style Selector="Button.login-method TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
      <Setter Property="LineHeight" Value="18" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Foreground" Duration="{Binding InteractiveState, Source={x:Static animation:MotionDurations.Source}}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.login-method:pointerover TextBlock, Button.login-method:focus-visible TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource ColorBrush2}" />
    </Style>
    <Style Selector="Canvas.login-method-icon">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Canvas.login-method-icon > Path">
      <Setter Property="Width" Value="24" />
      <Setter Property="Height" Value="24" />
      <Setter Property="Fill" Value="Transparent" />
      <Setter Property="Stroke" Value="{DynamicResource ColorBrush1}" />
      <Setter Property="StrokeThickness" Value="1.8" />
      <Setter Property="StrokeLineCap" Value="Round" />
      <Setter Property="StrokeJoin" Value="Round" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Stroke" Duration="{Binding InteractiveState, Source={x:Static animation:MotionDurations.Source}}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Button.login-method:pointerover Canvas.login-method-icon > Path, Button.login-method:focus-visible Canvas.login-method-icon > Path">
      <Setter Property="Stroke" Value="{DynamicResource ColorBrush2}" />
    </Style>
  </UserControl.Styles>
  <Grid x:Name="OverlayRoot" IsVisible="False" KeyboardNavigation.TabNavigation="Cycle">
    <Border
        x:Name="LoginBackdrop"
        Classes="pcl-dialog-overlay"
        Background="{DynamicResource ColorBrushPromptOverlayBackdrop}" />
    <Border
        x:Name="LoginCard"
        Classes="pcl-dialog-panel"
        Width="420"
        Margin="28"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Background="{DynamicResource ColorBrushMsgBox}"
        BoxShadow="{DynamicResource ColorShadowPromptPanel}"
        CornerRadius="7">
      <Grid RowDefinitions="Auto,2,13,*,Auto,Auto" Margin="22,22,22,23">
        <TextBlock
            x:Name="LoginPopupTitle"
            Margin="7,-1,70,9"
            FontSize="23"
            Foreground="{DynamicResource ColorBrush2}"
            TextWrapping="Wrap" />
        <Rectangle Grid.Row="1" Height="2" Fill="{DynamicResource ColorBrush2}" />
        <ScrollViewer Grid.Row="3" Margin="7,0,7,17"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <Grid x:Name="LoginStepContent">
            <StackPanel
                x:Name="AccountSelection"
                animation:Motion.AnimateOnVisible="True"
                animation:Motion.OffsetX="0"
                animation:Motion.OffsetY="12"
                IsVisible="False"
                Spacing="10">
              <TextBlock
                  Classes="auth-hint"
                  IsVisible="{Binding HasLaunchProfileEntries}"
                  Text="{Binding LaunchProfileSelectionHint}" />
              <ItemsControl x:Name="AccountSelectionEntries" ItemsSource="{Binding LaunchProfileEntries}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:LaunchProfileEntryViewModel">
                    <ui:PclListItem
                        Margin="1,2"
                        AutomationProperties.Name="{Binding Title}"
                        AccessoryCommand="{Binding AccessoryCommand}"
                        AccessoryIconData="{Binding AccessoryIconData}"
                        AccessoryIsSpinning="{Binding AccessoryIsSpinning}"
                        AccessoryToolTip="{Binding AccessoryToolTip}"
                        Command="{Binding Command}"
                        Focusable="True"
                        Info="{Binding Info}"
                        IsSelected="{Binding IsSelected}"
                        KeyDown="ProfileEntry_OnKeyDown"
                        SecondaryAccessoryCommand="{Binding SecondaryAccessoryCommand}"
                        SecondaryAccessoryIconData="{Binding SecondaryAccessoryIconData}"
                        SecondaryAccessoryToolTip="{Binding SecondaryAccessoryToolTip}"
                        Title="{Binding Title}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock
                  Classes="auth-hint"
                  IsVisible="{Binding HasNoLaunchProfileEntries}"
                  Text="{Binding LaunchProfileNoEntriesText}" />
            </StackPanel>

            <Grid
                x:Name="LoginMethodChooser"
                animation:Motion.AnimateOnVisible="True"
                animation:Motion.OffsetX="0"
                animation:Motion.OffsetY="12"
                IsVisible="False"
                HorizontalAlignment="Center"
                ColumnDefinitions="Auto,Auto,Auto"
                ColumnSpacing="48">
              <Button
                  x:Name="MicrosoftLoginMethod"
                  Classes="nochrome login-method"
                  AutomationProperties.Name="{Binding LaunchProfileChooserMicrosoftText}"
                  Command="{Binding LoginMicrosoftLaunchProfileCommand}">
                <StackPanel VerticalAlignment="Center" Spacing="12">
                  <Grid x:Name="MicrosoftLoginIcon" Width="32" Height="32"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas Classes="login-method-icon">
                      <Path Data="M3,3 H10 V10 H3 Z M14,3 H21 V10 H14 Z M3,14 H10 V21 H3 Z M14,14 H21 V21 H14 Z" />
                    </Canvas>
                  </Grid>
                  <TextBlock Text="{Binding LaunchProfileChooserMicrosoftText}" />
                </StackPanel>
              </Button>
              <Button
                  x:Name="OfflineLoginMethod"
                  Grid.Column="1"
                  Classes="nochrome login-method"
                  AutomationProperties.Name="{Binding LaunchProfileChooserOfflineText}"
                  Command="{Binding CreateOfflineLaunchProfileCommand}">
                <StackPanel VerticalAlignment="Center" Spacing="12">
                  <Grid x:Name="OfflineLoginIcon" Width="32" Height="32"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas Classes="login-method-icon">
                      <Path Data="M16,7 A4,4 0 1 1 8,7 A4,4 0 1 1 16,7 Z M4,21 V18 C4,13 20,13 20,18 V21 Z" />
                    </Canvas>
                  </Grid>
                  <TextBlock Text="{Binding LaunchProfileChooserOfflineText}" />
                </StackPanel>
              </Button>
              <Button
                  x:Name="ThirdPartyLoginMethod"
                  Grid.Column="2"
                  Classes="nochrome login-method"
                  AutomationProperties.Name="{Binding LaunchProfileChooserAuthlibText}"
                  Command="{Binding LoginAuthlibLaunchProfileCommand}">
                <StackPanel VerticalAlignment="Center" Spacing="12">
                  <Grid x:Name="ThirdPartyLoginIcon" Width="32" Height="32"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas Classes="login-method-icon">
                      <Path Data="M10,13 A5,5 0 0 0 17.54,13.54 L20.54,10.54 A5,5 0 0 0 13.47,3.47 L11.75,5.18 M14,11 A5,5 0 0 0 6.46,10.46 L3.46,13.46 A5,5 0 0 0 10.53,20.53 L12.24,18.82" />
                    </Canvas>
                  </Grid>
                  <TextBlock Text="{Binding LaunchProfileChooserAuthlibText}" />
                </StackPanel>
              </Button>
            </Grid>

            <Grid
                x:Name="OfflineEditor"
                animation:Motion.AnimateOnVisible="True"
                animation:Motion.OffsetX="0"
                animation:Motion.OffsetY="12"
                IsVisible="False"
                RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                RowSpacing="8">
              <TextBox
                  x:Name="OfflineUserName"
                  Text="{Binding LaunchOfflineUserName}"
                  Watermark="{Binding LaunchOfflineUserNameWatermark}" />
              <ComboBox
                  Grid.Row="1"
                  ItemsSource="{Binding LaunchOfflineUuidModeOptions}"
                  SelectedIndex="{Binding SelectedLaunchOfflineUuidModeIndex}" />
              <TextBox
                  Grid.Row="2"
                  IsVisible="{Binding IsLaunchOfflineCustomUuidVisible}"
                  Text="{Binding LaunchOfflineCustomUuid}"
                  Watermark="{Binding LaunchOfflineCustomUuidWatermark}" />
              <StackPanel Grid.Row="3" Spacing="5">
                <TextBlock Text="{Binding LaunchOfflineSkinLabel}" />
                <ComboBox
                    ItemsSource="{Binding LaunchOfflineSkinOptions}"
                    SelectedIndex="{Binding SelectedLaunchOfflineSkinIndex}" />
              </StackPanel>
              <TextBlock
                  Grid.Row="4"
                  FontSize="12.5"
                  Foreground="{DynamicResource ColorBrushLaunchStatusError}"
                  IsVisible="{Binding HasLaunchOfflineStatus}"
                  Text="{Binding LaunchOfflineStatusText}"
                  TextWrapping="Wrap" />
            </Grid>

            <StackPanel
                x:Name="MicrosoftEditor"
                animation:Motion.AnimateOnVisible="True"
                animation:Motion.OffsetX="0"
                animation:Motion.OffsetY="12"
                IsVisible="False"
                Spacing="12">
              <TextBlock
                  x:Name="MicrosoftLoginStatus"
                  FontSize="14"
                  Foreground="{DynamicResource ColorBrushEntrySecondaryIdle}"
                  IsVisible="{Binding ShowLaunchMicrosoftStatus}"
                  Text="{Binding LaunchMicrosoftStatusText}"
                  TextWrapping="Wrap" />
              <StackPanel
                  x:Name="MicrosoftDevicePrompt"
                  animation:Motion.AnimateOnVisible="True"
                  animation:Motion.OffsetX="0"
                  animation:Motion.OffsetY="8"
                  IsVisible="{Binding ShowLaunchMicrosoftDeviceCode}"
                  Spacing="14">
                <TextBlock
                    FontSize="14"
                    Foreground="{DynamicResource ColorBrushEntrySecondaryIdle}"
                    Text="{Binding LaunchMicrosoftCodeHint}"
                    TextWrapping="Wrap" />
                <Button
                    x:Name="MicrosoftDeviceCodeButton"
                    Classes="microsoft-device-code"
                    Margin="0,4"
                    HorizontalAlignment="Center"
                    Command="{Binding CopyMicrosoftDeviceCodeCommand}"
                    AutomationProperties.Name="{Binding LaunchMicrosoftCopyCodeText}">
                  <TextBlock
                      x:Name="MicrosoftDeviceCode"
                      FontFamily="Menlo, Monaco, Consolas"
                      FontSize="28"
                      Foreground="{DynamicResource ColorBrush2}"
                      Text="{Binding LaunchMicrosoftDeviceCodeDisplay}" />
                </Button>
              </StackPanel>
              <ProgressBar
                  x:Name="MicrosoftLoginProgress"
                  Height="3"
                  IsIndeterminate="True"
                  IsVisible="{Binding ShowLaunchMicrosoftProgress}" />
            </StackPanel>

            <StackPanel
                x:Name="AuthlibEditor"
                animation:Motion.AnimateOnVisible="True"
                animation:Motion.OffsetX="0"
                animation:Motion.OffsetY="12"
                IsVisible="False"
                Spacing="10">
              <StackPanel Spacing="7">
                <TextBlock Classes="auth-label" Text="{Binding LaunchAuthlibProviderLabel}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                  <RadioButton
                      x:Name="LittleSkinProvider"
                      Classes="auth-provider"
                      GroupName="AuthlibProvider"
                      IsChecked="{Binding IsLaunchAuthlibLittleSkinSelected, Mode=TwoWay}"
                      AutomationProperties.Name="LittleSkin">
                    <TextBlock Text="LittleSkin" FontWeight="Medium" />
                  </RadioButton>
                  <RadioButton
                      x:Name="CustomAuthlibProvider"
                      Grid.Column="1"
                      Classes="auth-provider"
                      GroupName="AuthlibProvider"
                      IsChecked="{Binding IsLaunchAuthlibCustomServerSelected, Mode=TwoWay}"
                      AutomationProperties.Name="{Binding LaunchAuthlibCustomServerText}">
                    <TextBlock Text="{Binding LaunchAuthlibCustomServerText}" FontWeight="Medium" />
                  </RadioButton>
                </Grid>
              </StackPanel>
              <StackPanel
                  x:Name="CustomAuthlibServerFields"
                  IsVisible="{Binding IsLaunchAuthlibCustomServerSelected}"
                  Spacing="6">
                <TextBlock Classes="auth-label" Text="{Binding LaunchAuthlibServerWatermark}" />
                <TextBox
                    x:Name="AuthlibServerUrl"
                    Text="{Binding LaunchAuthlibServer}"
                    AutomationProperties.Name="{Binding LaunchAuthlibServerWatermark}"
                    Watermark="https://example.com/api/yggdrasil" />
                <TextBlock Classes="auth-hint" Text="{Binding LaunchAuthlibServerHint}" />
              </StackPanel>
              <StackPanel Spacing="10">
                <Border Height="1" Background="{DynamicResource ColorBrushGray5}" />
                <TextBlock Classes="auth-hint"
                           IsVisible="{Binding IsLaunchAuthlibLittleSkinSelected}"
                           Text="{Binding LaunchAuthlibAccountHint}" />
                <StackPanel Spacing="6">
                  <TextBlock Classes="auth-label" Text="{Binding LaunchAuthlibUserNameWatermark}" />
                  <TextBox
                      x:Name="AuthlibUserName"
                      Text="{Binding LaunchAuthlibLoginName}"
                      AutomationProperties.Name="{Binding LaunchAuthlibUserNameWatermark}" />
                </StackPanel>
                <StackPanel Spacing="6">
                  <TextBlock Classes="auth-label" Text="{Binding LaunchAuthlibPasswordWatermark}" />
                  <TextBox
                      x:Name="AuthlibPassword"
                      PasswordChar="●"
                      Text="{Binding LaunchAuthlibPassword}"
                      AutomationProperties.Name="{Binding LaunchAuthlibPasswordWatermark}" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Grid>
        </ScrollViewer>
        <StackPanel Grid.Row="4" IsVisible="{Binding ShowLaunchAuthlibEditor}">
          <TextBlock
              x:Name="AuthlibLoginStatus"
              Margin="7,0,7,14"
              FontSize="12.5"
              Foreground="{DynamicResource ColorBrushLaunchStatusError}"
              IsVisible="{Binding HasLaunchAuthlibStatus}"
              Text="{Binding LaunchAuthlibStatusText}"
              TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel
            x:Name="LoginActions"
            Grid.Row="5"
            Margin="0,0,8,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="12">
          <ui:PclButton
              MinWidth="100"
              ContentPadding="8,5"
              TextMargin="0,-1,0,0"
              Command="{Binding OpenMicrosoftDeviceLinkCommand}"
              IsVisible="{Binding ShowLaunchMicrosoftDeviceCode}"
              Text="{Binding LaunchMicrosoftReopenBrowserText}" />
          <ui:PclButton
              MinWidth="96"
              ContentPadding="8,5"
              TextMargin="0,-1,0,0"
              ColorType="Highlight"
              Command="{Binding SubmitOfflineLaunchProfileCommand}"
              IsVisible="{Binding ShowLaunchOfflineEditor}"
              Text="{Binding LaunchOfflineCreateText}" />
          <ui:PclButton
              x:Name="AuthlibSignInButton"
              MinWidth="96"
              ContentPadding="8,5"
              TextMargin="0,-1,0,0"
              ColorType="Highlight"
              Command="{Binding SubmitAuthlibLaunchProfileCommand}"
              IsVisible="{Binding ShowLaunchAuthlibEditor}"
              Text="{Binding LaunchAuthlibLoginText}" />
          <ui:PclButton
              x:Name="MicrosoftSignInButton"
              MinWidth="96"
              ContentPadding="8,5"
              TextMargin="0,-1,0,0"
              ColorType="Highlight"
              Command="{Binding SubmitMicrosoftLaunchProfileCommand}"
              IsVisible="{Binding ShowLaunchMicrosoftRetry}"
              Text="{Binding LaunchMicrosoftPrimaryButtonText}" />
          <ui:PclButton
              x:Name="AddAccountFromSelectionButton"
              MinWidth="96"
              ContentPadding="8,5"
              TextMargin="0,-1,0,0"
              ColorType="Highlight"
              Command="{Binding AddLaunchProfileCommand}"
              IsVisible="{Binding ShowLaunchProfileSelection}"
              Text="{Binding LaunchProfileAddTooltip}" />
          <ui:PclButton
              x:Name="CloseLoginPopupButton"
              MinWidth="96"
              ContentPadding="8,5"
              TextMargin="0,-1,0,0"
              Command="{Binding BackLaunchProfileCommand}"
              Text="{Binding LaunchProfilePopupCancelText}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</UserControl>
