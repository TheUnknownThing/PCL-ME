<UserControl
    x:Class="PCL.Frontend.Avalonia.Desktop.Panes.Right.VersionSaveInfoRightPaneView"
    xmlns="https://github.com/avaloniaui"
    xmlns:ui="clr-namespace:PCL.UI.Controls;assembly=PCL.UI"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:PCL.Frontend.Avalonia.ViewModels"
    x:DataType="vm:LauncherViewModel"
    xmlns:controls="clr-namespace:PCL.Frontend.Avalonia.Desktop.Controls"
    DataContext="{ReflectionBinding Launcher}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="25,10,25,10" Spacing="15">
      <ui:PclCard Header="{Binding VersionSaveInfoHeaderText}" ContentMargin="18,40,18,16">
        <ui:PclCard.CardContent>
          <ItemsControl ItemsSource="{Binding VersionSaveInfoEntries}" IsVisible="{Binding HasVersionSaveInfoEntries}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,10" ColumnDefinitions="Auto,24,*">
                  <TextBlock
                      Foreground="{DynamicResource ColorBrushEntrySecondaryIdle}"
                      FontSize="12.5"
                      Text="{Binding Label}" />
                  <TextBlock
                      Grid.Column="2"
                      Foreground="{DynamicResource ColorBrush1}"
                      FontSize="13"
                      Text="{Binding Value}"
                      TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ui:PclCard.CardContent>
      </ui:PclCard>

      <ui:PclCard Header="{Binding VersionSaveSettingsHeaderText}" ContentMargin="18,40,18,16" IsVisible="{Binding HasVersionSaveSettingEntries}">
        <ui:PclCard.CardContent>
          <ItemsControl ItemsSource="{Binding VersionSaveSettingEntries}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid Margin="0,0,0,10" ColumnDefinitions="Auto,24,*">
                  <TextBlock
                      Foreground="{DynamicResource ColorBrushEntrySecondaryIdle}"
                      FontSize="12.5"
                      Text="{Binding Label}" />
                  <TextBlock
                      Grid.Column="2"
                      Foreground="{DynamicResource ColorBrush1}"
                      FontSize="13"
                      Text="{Binding Value}"
                      TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ui:PclCard.CardContent>
      </ui:PclCard>
    </StackPanel>
  </ScrollViewer>
</UserControl>
