<UserControl
    x:Class="PCL.Frontend.Avalonia.Desktop.Panes.Right.Sections.InstanceOverviewShortcutsSection"
    xmlns="https://github.com/avaloniaui"
    xmlns:ui="clr-namespace:PCL.UI.Controls;assembly=PCL.UI"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:PCL.Frontend.Avalonia.ViewModels"
    x:DataType="vm:LauncherViewModel"
    xmlns:controls="clr-namespace:PCL.Frontend.Avalonia.Desktop.Controls">
  <ui:PclCard Header="{Binding InstanceOverviewShortcutsHeaderText}" ContentMargin="20,40,20,18">
    <ui:PclCard.CardContent>
      <Grid ColumnDefinitions="Auto,Auto,Auto">
        <ui:PclButton
            Grid.Column="0"
            MinWidth="140"
            Margin="0,0,20,0"
            Command="{Binding OpenInstanceFolderCommand}"
            Text="{Binding InstanceOverviewOpenInstanceFolderText}" />
        <ui:PclButton
            Grid.Column="1"
            MinWidth="140"
            Margin="0,0,20,0"
            Command="{Binding OpenInstanceSavesFolderCommand}"
            Text="{Binding InstanceOverviewOpenSavesFolderText}" />
        <ui:PclButton
            Grid.Column="2"
            MinWidth="140"
            Command="{Binding OpenInstanceModsFolderCommand}"
            Text="{Binding InstanceOverviewOpenModsFolderText}" />
      </Grid>
    </ui:PclCard.CardContent>
  </ui:PclCard>
</UserControl>
