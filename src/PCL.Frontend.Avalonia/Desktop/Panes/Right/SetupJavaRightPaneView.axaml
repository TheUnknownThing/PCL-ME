<UserControl
    x:Class="PCL.Frontend.Avalonia.Desktop.Panes.Right.SetupJavaRightPaneView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="clr-namespace:PCL.Frontend.Avalonia.ViewModels"
    xmlns:motion="clr-namespace:PCL.UI.Animation;assembly=PCL.UI"
    xmlns:ui="clr-namespace:PCL.UI.Controls;assembly=PCL.UI"
    x:DataType="vm:LauncherViewModel"
    x:Name="Root"
    DataContext="{ReflectionBinding Launcher}">
  <UserControl.Styles>
    <Style Selector="RadioButton.java-choice">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="Transparent" Padding="{TemplateBinding Padding}">
            <Grid ColumnDefinitions="18,*">
              <Grid Width="16" Height="16" VerticalAlignment="Center">
                <Path x:Name="DisabledMark" Data="M4,8 L12,8" Stroke="{DynamicResource ColorBrushEntrySecondaryIdle}" StrokeThickness="1.5" IsVisible="False" />
                <Ellipse
                    x:Name="ChoiceRing"
                    Stroke="{DynamicResource ColorBrushEntrySecondaryIdle}"
                    StrokeThickness="1.5" />
                <Ellipse
                    x:Name="ChoiceDot"
                    Width="8"
                    Height="8"
                    Fill="{DynamicResource ColorBrush3}"
                    IsVisible="False" />
              </Grid>
              <ContentPresenter
                  Grid.Column="1"
                  Margin="10,0,0,0"
                  Content="{TemplateBinding Content}"
                  ContentTemplate="{TemplateBinding ContentTemplate}"
                  HorizontalContentAlignment="Stretch" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.java-choice:checked /template/ Ellipse#ChoiceRing">
      <Setter Property="Stroke" Value="{DynamicResource ColorBrush3}" />
    </Style>
    <Style Selector="RadioButton.java-choice:checked /template/ Ellipse#ChoiceDot">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="RadioButton.java-choice:disabled /template/ Path#DisabledMark">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="TextBlock.java-title">
      <Setter Property="Foreground" Value="{DynamicResource ColorBrush1}" />
    </Style>
    <Style Selector="RadioButton.java-choice:disabled TextBlock.java-title">
      <Setter Property="Foreground" Value="{DynamicResource ColorBrushEntrySecondaryIdle}" />
      <Setter Property="TextDecorations" Value="Strikethrough" />
    </Style>
    <Style Selector="Border.java-row">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
    </Style>
    <Style Selector="Border.java-highlight">
      <Setter Property="Background" Value="{DynamicResource ColorBrushEntryHoverBackground}" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Opacity" Value="0" />
      <Setter Property="IsHitTestVisible" Value="False" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Opacity" Duration="{Binding InteractiveState, Source={x:Static motion:MotionDurations.Source}}" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.java-row:pointerover Border.java-highlight">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.java-row.selected Border.java-highlight">
      <Setter Property="Background" Value="{DynamicResource ColorBrushEntrySelectedBackground}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Border.java-row.disabled Border.java-highlight">
      <Setter Property="Background" Value="{DynamicResource ColorBrushBg1}" />
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="Border.java-row:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush3}" />
    </Style>
    <Style Selector=".compact RadioButton.java-choice">
      <Setter Property="Grid.ColumnSpan" Value="2" />
    </Style>
    <Style Selector="StackPanel.java-actions">
      <Setter Property="Grid.Column" Value="1" />
      <Setter Property="Margin" Value="4,0,10,0" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector=".compact StackPanel.java-actions">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.Row" Value="1" />
      <Setter Property="Grid.ColumnSpan" Value="2" />
      <Setter Property="Margin" Value="40,0,10,8" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="25,25,25,10">
      <ui:PclCard Header="{Binding SetupText.Java.RuntimesCardHeader}" ContentMargin="12,36,12,12">
        <ui:PclCard.CardContent>
          <StackPanel Spacing="4">
            <Border Classes="java-row" Classes.selected="{Binding IsAutoJavaSelected}">
              <Grid>
                <Border Classes="java-highlight" />
                <RadioButton
                    x:Name="AutoJavaChoice"
                    Classes="java-choice"
                    GroupName="SetupJavaRuntime"
                    IsChecked="{Binding IsAutoJavaSelected, Mode=OneWay}"
                    Command="{Binding SelectAutoJavaCommand}"
                    AutomationProperties.Name="{Binding SetupText.Java.AutoSelectLabel}">
                  <StackPanel Spacing="3">
                    <TextBlock
                        Foreground="{DynamicResource ColorBrush1}"
                        FontSize="13.5"
                        Text="{Binding SetupText.Java.AutoSelectLabel}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{DynamicResource ColorBrushEntrySecondaryIdle}"
                        FontSize="12"
                        Text="{Binding SetupText.Java.AutoSelectDescription}"
                        TextWrapping="Wrap" />
                  </StackPanel>
                </RadioButton>
              </Grid>
            </Border>

            <Border
                Height="1"
                Margin="12,6"
                Background="{DynamicResource ColorBrushMyCardEdge}"
                IsVisible="{Binding HasJavaRuntimeEntries}" />

            <ItemsControl ItemsSource="{Binding JavaRuntimeEntries}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:JavaRuntimeEntryViewModel">
                  <Border Classes="java-row" Classes.selected="{Binding IsSelected}" Classes.disabled="{Binding !IsEnabled}" Margin="0,0,0,2">
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                      <Border Classes="java-highlight" Grid.ColumnSpan="2" Grid.RowSpan="2" />
                      <RadioButton
                          Classes="java-choice"
                          GroupName="SetupJavaRuntime"
                          IsEnabled="{Binding IsEnabled}"
                          IsChecked="{Binding IsSelected, Mode=OneWay}"
                          Command="{Binding SelectCommand}"
                          AutomationProperties.Name="{Binding Title}"
                          AutomationProperties.HelpText="{Binding Info}">
                        <StackPanel Spacing="3">
                          <TextBlock
                              Classes="java-title"
                              FontSize="13.5"
                              Text="{Binding Title}"
                              TextTrimming="CharacterEllipsis" />
                          <TextBlock
                              Foreground="{DynamicResource ColorBrushEntrySecondaryIdle}"
                              FontSize="12"
                              Text="{Binding Info}"
                              TextTrimming="CharacterEllipsis"
                              ToolTip.Tip="{Binding Info}" />
                        </StackPanel>
                      </RadioButton>
                      <StackPanel Classes="java-actions" Orientation="Horizontal" Spacing="2">
                        <ui:PclIconButton
                            Command="{Binding OpenCommand}"
                            IconData="{Binding OpenIconData}"
                            IconBrush="{DynamicResource ColorBrush3}"
                            HoverBackgroundBrush="{DynamicResource ColorBrushBg1}"
                            ToolTip.Tip="{Binding DataContext.SetupText.Java.OpenButton, ElementName=Root}"
                            AutomationProperties.Name="{Binding DataContext.SetupText.Java.OpenButton, ElementName=Root}" />
                        <ui:PclIconButton
                            Command="{Binding InfoCommand}"
                            IconData="{Binding InfoIconData}"
                            IconBrush="{DynamicResource ColorBrush3}"
                            HoverBackgroundBrush="{DynamicResource ColorBrushBg1}"
                            ToolTip.Tip="{Binding DataContext.SetupText.Java.DetailsButton, ElementName=Root}"
                            AutomationProperties.Name="{Binding DataContext.SetupText.Java.DetailsButton, ElementName=Root}" />
                        <ui:PclIconButton
                            Command="{Binding ToggleEnabledCommand}"
                            IconData="{Binding ToggleIconData}"
                            IconBrush="{DynamicResource ColorBrush3}"
                            HoverBackgroundBrush="{DynamicResource ColorBrushBg1}"
                            ToolTip.Tip="{Binding ToggleButtonText}"
                            AutomationProperties.Name="{Binding ToggleButtonText}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Height="1" Margin="12,8" Background="{DynamicResource ColorBrushMyCardEdge}" />
            <WrapPanel Margin="12,0,4,0">
              <ui:PclButton
                  x:Name="DownloadJavaButton"
                  MinWidth="110"
                  Margin="0,0,8,8"
                  ColorType="Highlight"
                  Command="{Binding DownloadJavaRuntimeCommand}"
                  Text="{Binding SetupText.Java.DownloadButton}" />
              <ui:PclButton
                  x:Name="InstallJavaButton"
                  MinWidth="110"
                  Margin="0,0,8,8"
                  Command="{Binding AddJavaRuntimeCommand}"
                  Text="{Binding SetupText.Java.InstallButton}" />
            </WrapPanel>
          </StackPanel>
        </ui:PclCard.CardContent>
      </ui:PclCard>
    </StackPanel>
  </ScrollViewer>
</UserControl>
